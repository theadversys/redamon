# =============================================================================
# PandaExploit — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in at least one AI provider key.
#   cp .env.example .env
#
# All values below have sane defaults — you only NEED to set an AI key.
# =============================================================================

# ---------------------------------------------------------------------------
# AI Provider Keys (at least one required)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=              # recommended
OPENAI_API_KEY=
GOOGLE_API_KEY=                 # Google Gemini API key

# ---------------------------------------------------------------------------
# Optional API Keys
# ---------------------------------------------------------------------------
TAVILY_API_KEY=                 # web search for AI agent
LINODE_API_KEY=                 # Linode (Akamai) for BlackArch MCP provisioning
NVD_API_KEY=                    # NIST NVD (higher rate limits for vuln lookups)

# ---------------------------------------------------------------------------
# Recon output path (Vulnerabilities page scan status)
# ---------------------------------------------------------------------------
# Path to recon JSON files (recon_{projectId}.json). Used for scan metadata
# (modules_executed, active_scans_skipped). Must match where recon pipeline writes.
#   Local dev: ./recon/output (relative to project root)
#   Docker:    /app/recon/output (set by compose)
RECON_OUTPUT_PATH=./recon/output

# ---------------------------------------------------------------------------
# Neo4j (required for Vulnerabilities page, Graph Map)
# ---------------------------------------------------------------------------
# Docker Compose: NEO4J_URI/USER are set in compose; only set password here.
# Local dev (npm run dev): set all three; Neo4j must be running (e.g. docker compose up -d neo4j).
NEO4J_PASSWORD=changeme123       # Must match Neo4j NEO4J_AUTH (default in compose)
# For local dev only (webapp outside Docker):
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j

# ---------------------------------------------------------------------------
# Ports (optional - use when default is in use)
# ---------------------------------------------------------------------------
WEBAPP_PORT=3000                 # Webapp port (default 3000; use 3002 if 3000 is busy)
KILL_CHAIN_ORCHESTRATOR_PORT=8015
#
# Kill Chain Orchestrator — Full cyber kill chain automation (stages 1-7)
#   Local dev: KILL_CHAIN_ORCHESTRATOR_URL=http://localhost:8015
#   Docker:    KILL_CHAIN_ORCHESTRATOR_URL=http://kill-chain-orchestrator:8015
KILL_CHAIN_ORCHESTRATOR_URL=
#
# LHOST for payload generation (Stage 2). Overrides project agentLhost if set.
# Required for Stage 2 (Weaponization) when generating reverse shells.
# Example: KILL_CHAIN_LHOST=10.0.0.1  (your host IP for callbacks)
KILL_CHAIN_LHOST=

# Recon container uses network_mode: host and cannot resolve Docker hostnames.
# Override when RECON_WEBAPP_API_URL differs from WEBAPP_URL (e.g. custom port).
# RECON_WEBAPP_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GitHub API (agent→webapp) & Agent Zero
# ---------------------------------------------------------------------------
AGENT_SERVICE_TOKEN=            # Bearer token for agent + PandaExploit MCP + Agent Zero + OpenCode IDE (generate: openssl rand -hex 32)
NEXT_PUBLIC_APP_URL=            # App URL for same-origin browser auth (e.g. http://localhost:3000)

# ---------------------------------------------------------------------------
# Agent Zero (optional - general-purpose AI agent tab)
# ---------------------------------------------------------------------------
# AGENT_SERVICE_TOKEN is passed to Agent Zero for GitHub API auth when using PandaExploit MCP tools
A0_PORT=50001                   # Agent Zero UI port (default 50001)
#
# AGENT_ZERO_URL — Server-side proxy target for /api/a0. If unset, defaults to http://localhost:50001.
#
#   Local dev (webapp outside Docker):
#     Leave unset, or set AGENT_ZERO_URL=http://localhost:50001
#     Do NOT use agent-zero hostname — it will not resolve outside Docker.
#
#   Docker Compose (webapp + Agent Zero in same compose):
#     Set AGENT_ZERO_URL=http://agent-zero:80
#
AGENT_ZERO_URL=
NEXT_PUBLIC_AGENT_ZERO_URL=     # Leave unset to use same-origin proxy (/api/a0) for iframe embedding
A0_SSL_VERIFY=false             # Set to true for strict SSL; false bypasses cert verification (corporate proxy/MITM)


# ---------------------------------------------------------------------------
# AI Security (Promptfoo Red Teaming)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY is required for red team attack generation and LLM graders.
#
# PROMPTFOO_API_KEY enables Promptfoo Cloud remote generation for higher-quality
# adversarial inputs. Required for remote-only plugins (harmful:*, bias:*, etc.).
# When set, remote generation is auto-enabled. Without it, only local plugins work.
PROMPTFOO_API_KEY=
#
# Override remote generation behavior (auto-detected from PROMPTFOO_API_KEY):
# PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=true
#
# HuggingFace token for dataset plugins (beavertails, aegis, unsafebench):
HF_TOKEN=
#
PROMPTFOO_MCP_PORT=3100          # Promptfoo MCP server port for Agent Zero integration

# ---------------------------------------------------------------------------
# SpiderFoot (OSINT)
# ---------------------------------------------------------------------------
SPIDERFOOT_PORT=5001

# ---------------------------------------------------------------------------
# Ticket provider (vulnerability → GitHub/Jira)
# ---------------------------------------------------------------------------
# GitHub: create issues from vuln detail/preview. Uses project.githubAccessToken
# if set; otherwise GITHUB_ACCESS_TOKEN. Repo can be passed in API body or here.
GITHUB_ACCESS_TOKEN=
GITHUB_ISSUES_REPO=             # owner/repo (e.g. myorg/security-issues)
#
# Jira: create issues. All four vars required.
JIRA_BASE_URL=                  # e.g. https://your-domain.atlassian.net
JIRA_PROJECT_KEY=               # e.g. SEC
JIRA_EMAIL=                     # Jira account email
JIRA_API_TOKEN=                 # API token from https://id.atlassian.com/manage-profile/security/api-tokens

# ---------------------------------------------------------------------------
# Optional external MCP servers (BlackArch)
# ---------------------------------------------------------------------------
# If you run your own BlackArch MCP instance, set the URL here and manually
# re-add it to conf/agent-zero-mcp-servers.json and conf/agent-zero-mcp-servers-a0-conf.json
# Example: BLACKARCH_MCP_URL=http://your-server:8080/sse
BLACKARCH_MCP_URL=

# ---------------------------------------------------------------------------
# Kill Chain Security
# ---------------------------------------------------------------------------
# Secret token for kill chain webhook endpoint. Set to a random string to
# prevent unauthorized stage events from being injected.
KILL_CHAIN_WEBHOOK_SECRET=      # recommended: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Passive Recon APIs  (SpiderFoot modules)
# ---------------------------------------------------------------------------
SHODAN_API_KEY=                 # shodan.io API key for passive port/service data
CENSYS_API_ID=                  # censys.io API ID
CENSYS_API_SECRET=              # censys.io API secret
VIRUSTOTAL_API_KEY=             # virustotal.com threat intelligence
HIBP_API_KEY=                   # haveibeenpwned.com breach data (requires paid plan)
HUNTER_API_KEY=                 # hunter.io email discovery
